LEMORIA_ENV=development
LEMORIA_DB_HOST=localhost
LEMORIA_DB_PORT=5432
LEMORIA_DB_NAME=lemoria
LEMORIA_DB_USER=lemoria
LEMORIA_DB_PASSWORD=lemoria
# Vault: memoria PRIVADA (conversaciones, ADRs, PRDs). Mantenla fuera de cualquier
# repo git. Por defecto es ~/.lemoria/vault. Si la apontas dentro de un repo,
# VaultService.protect_from_git() la agrega sola al .gitignore de ese repo.
LEMORIA_VAULT_PATH=~/.lemoria/vault
LEMORIA_OBSIDIAN_PATH=
# Opcional: solo si usas gh autenticado para operaciones GitHub
# LEMORIA_GITHUB_TOKEN=
LEMORIA_OPENCODE_AGENTS_DIR=./.opencode/agents
